# Application (Production-Safe Defaults)
APP_NAME=Atom
APP_ENV=production
APP_DEBUG=false
APP_URL=https://localhost
APP_FORCE_HTTPS=true
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_TO_TIMEZONE=Europe/Warsaw

# Stateless / Swoole / Microservices
APP_STATELESS=true
APP_MICROSERVICE=false
APP_NO_DB=false
APP_RUNTIME_ENGINE=fpm
SWOOLE_ON=false
SWOOLE_HOST=0.0.0.0
SWOOLE_PORT=9501
SWOOLE_MAX_REQUEST=10000

# Asset Minification & SQL Migrations (Disabled by Default)
APP_SHRINK=true
APP_SHRINK_AUTO_MINIFY=false
APP_AUTO_MIGRATE=false
DB_AUTO_MIGRATE=false
MODULE_USER_AUTH=true

# Security & Rate Limiting
APP_SECURITY_HEADERS=true
APP_SECURITY_CSRF=true
APP_RATE_LIMITER=true
APP_RATE_LIMITER_MAX_ATTEMPTS=120
APP_RATE_LIMITER_DECAY_SECONDS=60

# Database & Connection Pool
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Atom
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_ON=false
DB_POOL_MAX=32

# Redis & Stateless Session / Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_POOL_ON=false

# Session Hardening (PHP 8.6 aligned)
SESSION_SECURE=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_USE_STRICT_MODE=true
SESSION_NEW_SESSION_WHEN_LOGIN=true

# Logging
LOG_DRIVER=log
LOG_LEVEL=warning

# Cluster, Encrypted Exchange, OAuth & MCP Server
CLUSTER_ON=false
CLUSTER_DRIVER=redis
CLUSTER_REDIS_ON=true
CLUSTER_REDIS_ROUTE_ALL=true
CLUSTER_NODE_ID=atom-node-1
CLUSTER_NODE_ROLE=worker
CLUSTER_ENCRYPTION_ON=true
CLUSTER_REMOTE_DB_ON=false
CLUSTER_SUPERVISOR_ON=true
CLUSTER_BACKUP_SUPERVISOR_ON=true
MODULE_ATOM_EXCHANGE=true
MODULE_ATOM_CLUSTER=false
MODULE_OAUTH=true
OAUTH_STORE_DRIVER=redis
MCP_SERVER_ON=false
MODULE_MCP_SERVER=false
MCP_ALLOW_WRITE_ACTIONS=false

# Performance Profiler, Timonix Cloud Telemetry & Visual Traffic Inspector (Disabled on Production by Default)
PROFILER_ON=false
MODULE_PERFORMANCE_PROFILER=false
PROFILER_MODE=visual
TRAFFIC_INSPECTOR_ON=false
MODULE_TRAFFIC_INSPECTOR=false

# PHP 8.6 Fibers, Io\Poll & Swoole Asynchronous Engine
ASYNC_ON=true
ASYNC_DRIVER=auto
ASYNC_DEFAULT_CONCURRENCY=32



