# Application (Production-Safe Defaults)
APP_NAME=Atom
APP_ENV=production
APP_DEBUG=false
APP_URL=https://localhost
APP_FORCE_HTTPS=true
APP_LOCALE=pl
APP_FALLBACK_LOCALE=en
APP_TO_TIMEZONE=Europe/Warsaw

# Stateless / Swoole / Microservices
APP_STATELESS=true
APP_RUNTIME_ENGINE=fpm
SWOOLE_ON=false
SWOOLE_HOST=0.0.0.0
SWOOLE_PORT=9501
SWOOLE_MAX_REQUEST=10000

# Security & Rate Limiting
APP_SECURITY_HEADERS=true
APP_SECURITY_CSRF=true
APP_RATE_LIMITER=true
APP_RATE_LIMITER_MAX_ATTEMPTS=120
APP_RATE_LIMITER_DECAY_SECONDS=60

# Database & Connection Pool
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=Atom
DB_USERNAME=root
DB_PASSWORD=
DB_POOL_ON=false
DB_POOL_MAX=32

# Redis & Stateless Session / Cache
CACHE_DRIVER=redis
SESSION_DRIVER=redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_POOL_ON=false

# Session Hardening (PHP 8.6 aligned)
SESSION_SECURE=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_USE_STRICT_MODE=true
SESSION_NEW_SESSION_WHEN_LOGIN=true

# Logging
LOG_DRIVER=log
LOG_LEVEL=warning
