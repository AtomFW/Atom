<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
            colors="true">
    <testsuites>
        <testsuite name="Atop Test Suite">
            <directory>tests/Atom</directory>
        </testsuite>
        <testsuite name="App Test Suite">
            <directory>tests/App</directory>
        </testsuite>
        <testsuite name="Modules Test Suite">
            <directory suffix="Test.php">Atom/Modules</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_ENV" value="test"/>
        <env name="DB_NAME" value="test_db"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="test"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>

        <ini name="error_reporting" value="-1" />
        <ini name="display_errors" value="1" />
    </php>
</phpunit>